{
  "name": "florangi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file=.env --import tsx ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "catalog:preview": "node --conditions=react-server --env-file=.env --import tsx scripts/import-preview-catalog.ts",
    "storage:migrate-preview": "node --conditions=react-server --env-file=.env --import tsx scripts/migrate-preview-images-to-cloudinary.ts",
    "worker": "node --conditions=react-server --env-file=.env --import tsx src/server/worker.ts",
    "storage:migrate-cloudinary": "node --conditions=react-server --env-file=.env --import tsx scripts/migrate-storage-to-cloudinary.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.6",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
