generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  DESIGNER_DRESS
  CUSTOM_DRESS
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum DressSize {
  XS
  S
  M
}

enum PaymentMethod {
  ONLINE
  COD
}

enum FulfillmentStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  APPROVED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  COD_PENDING
  COD_COLLECTED
  REFUND_REQUIRED
  REFUNDED
}

enum StockMovementType {
  ADJUSTMENT
  RESERVATION
  RELEASE
  SHIPMENT
  REPLACEMENT_ALLOCATION
  REPLACEMENT_RELEASE
  RESTOCK
}

enum PaymentAttemptStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  UNKNOWN
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
  UNKNOWN
}

enum ReplacementStatus {
  OPEN
  ACCEPTED
  REJECTED
  RESOLVED
}

enum EmailJobStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  DEFERRED
  CANCELLED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AdminUser {
  id               String                 @id @default(cuid())
  email            String                 @unique
  passwordHash     String
  name             String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  sessions         AdminSession[]
  stockMovements   StockMovement[]        @relation("StockMovementActor")
  timelineEvents   OrderTimelineEvent[]   @relation("TimelineActor")
  orderNotes       OrderNote[]            @relation("NoteAuthor")
  auditLogs        AuditLog[]
  measurementEdits MeasurementVersion[]   @relation("MeasurementEditor")
  settingsCreated  Setting[]              @relation("SettingAuthor")
}

model AdminSession {
  id          String   @id @default(cuid())
  adminUserId String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  visible   Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  images    CategoryImage[]
}

model CategoryImage {
  id         String   @id @default(cuid())
  categoryId String
  provider   String
  key        String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  position   Int
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, position])
  @@unique([provider, key])
}

model Product {
  id                     String          @id @default(cuid())
  categoryId             String
  name                   String
  slug                   String          @unique
  description            String
  type                   ProductType
  basePricePaise         Int
  customizationFeePaise  Int?
  status                 ProductStatus   @default(DRAFT)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  category               Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                 ProductImage[]
  variants               ProductVariant[]
  cartLines              CartLine[]
  orderLines             OrderLine[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  provider  String
  key       String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  position  Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@unique([provider, key])
}

model ProductVariant {
  id               String            @id @default(cuid())
  productId        String
  size             DressSize
  sizePremiumPaise Int               @default(0)
  onHand           Int               @default(0)
  reserved         Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements   StockMovement[]
  cartLines        CartLine[]
  orderLines       OrderLine[]
  replacementLines ReplacementRequestLine[] @relation("ReplacementAllocation")

  @@unique([productId, size])
}

model StockMovement {
  id          String           @id @default(cuid())
  variantId   String
  orderId     String?
  actorUserId String?
  type        StockMovementType
  quantity    Int
  note        String?
  createdAt   DateTime         @default(now())
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor       AdminUser?       @relation("StockMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model Cart {
  id             String     @id @default(cuid())
  guestTokenHash String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lines          CartLine[]
}

model CartLine {
  id                String          @id @default(cuid())
  cartId            String
  productId         String
  variantId         String?
  measurements      Json?
  quantity          Int             @default(1)
  acceptedUnitPaise Int?
  quoteVersion      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([cartId])
}

model Order {
  id                    String             @id @default(cuid())
  orderNumber           String             @unique
  firstName             String
  lastName              String
  phoneNumber           String
  email                 String
  fulfillmentStatus     FulfillmentStatus
  paymentStatus         PaymentStatus
  paymentMethod         PaymentMethod
  currency              String             @default("INR")
  subtotalPaise         Int
  shippingFeePaise      Int
  codSurchargePaise     Int
  totalPaise            Int
  addressSnapshot       Json
  settingsSnapshot      Json
  paymentDeadline       DateTime?
  idempotencyKey        String
  idempotencyPayloadHash String
  razorpayOrderId       String?            @unique
  confirmedAt           DateTime?
  confirmationMethod    String?
  confirmationNote      String?
  codCollectedAt        DateTime?
  codCollectedAmountPaise Int?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lines                 OrderLine[]
  stockMovements        StockMovement[]
  paymentAttempts       PaymentAttempt[]
  refunds               Refund[]
  timeline              OrderTimelineEvent[]
  notes                 OrderNote[]
  shipment              Shipment?
  replacementRequests  ReplacementRequest[]
  confirmationTokens   OrderConfirmationToken[]
  accessTokens         OrderAccessToken[]

  @@unique([idempotencyKey])
  @@index([fulfillmentStatus, createdAt])
  @@index([paymentStatus, paymentDeadline])
}

model OrderCounter {
  year      Int      @id
  nextValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model OrderLine {
  id                    String              @id @default(cuid())
  orderId               String
  productId             String
  productName           String
  productImage          Json?
  productType           ProductType
  variantId             String?
  size                  DressSize?
  measurementsSnapshot  Json?
  quantity              Int
  unitPricePaise        Int
  customizationFeePaise Int                 @default(0)
  isReady               Boolean             @default(false)
  qcCompletedAt         DateTime?
  qcCompletedBy         String?
  qcNotes               String?
  createdAt             DateTime            @default(now())
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product               Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant               ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  measurementVersions   MeasurementVersion[]
  replacementLines      ReplacementRequestLine[]

  @@index([orderId])
}

model MeasurementVersion {
  id                    String    @id @default(cuid())
  orderLineId           String
  version               Int
  values                Json
  authorType            String
  authorUserId          String?
  correctionReason      String?
  usedForProductionAt   DateTime?
  createdAt             DateTime  @default(now())
  orderLine             OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  author                AdminUser? @relation("MeasurementEditor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([orderLineId, version])
}

model PaymentAttempt {
  id                    String               @id @default(cuid())
  orderId               String
  provider              String
  providerOrderId       String?
  providerPaymentId     String?              @unique
  amountPaise           Int
  currency              String               @default("INR")
  status                PaymentAttemptStatus @default(CREATED)
  failureCode           String?
  failureMessage        String?
  verifiedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  order                 Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @unique
  eventType       String
  payload         Json
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  processingError String?
}

model OrderConfirmationToken {
  id        String    @id @default(cuid())
  orderId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, expiresAt])
}

model OrderAccessToken {
  id        String    @id @default(cuid())
  orderId   String
  tokenHash String    @unique
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, revokedAt])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  providerRefundId String?      @unique
  amountPaise     Int
  currency        String       @default("INR")
  status          RefundStatus @default(PENDING)
  idempotencyKey  String       @unique
  requestedAt     DateTime     @default(now())
  completedAt     DateTime?
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model OrderTimelineEvent {
  id          String   @id @default(cuid())
  orderId     String
  actorUserId String?
  actorName   String
  action      String
  fromState   String?
  toState     String?
  note        String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor       AdminUser? @relation("TimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderNote {
  id          String   @id @default(cuid())
  orderId     String
  authorId    String?
  body        String
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author      AdminUser? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorType   String
  action      String
  entity      String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  actor       AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
}

model Shipment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  courierName   String
  awbNumber     String
  trackingUrl   String?
  shippedAt     DateTime
  deliveredAt   DateTime?
  exceptionNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model ReplacementRequest {
  id              String              @id @default(cuid())
  orderId         String
  status          ReplacementStatus   @default(OPEN)
  reason          String
  notes           String?
  decisionReason  String?
  logisticsNote   String?
  exception       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  resolvedAt      DateTime?
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines           ReplacementRequestLine[]
  photos          ReplacementPhoto[]

  @@index([status, createdAt])
  @@index([orderId])
}

model ReplacementRequestLine {
  id                    String               @id @default(cuid())
  requestId             String
  orderLineId           String
  desiredSize           DressSize?
  fitCorrection         String?
  allocatedVariantId    String?
  allocatedAt           DateTime?
  createdAt             DateTime             @default(now())
  request               ReplacementRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderLine             OrderLine            @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  allocatedVariant      ProductVariant?      @relation("ReplacementAllocation", fields: [allocatedVariantId], references: [id], onDelete: Restrict)

  @@unique([requestId, orderLineId])
}

model ReplacementPhoto {
  id           String             @id @default(cuid())
  requestId    String
  provider     String
  key          String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime           @default(now())
  request      ReplacementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([provider, key])
}

model Setting {
  id          String   @id @default(cuid())
  key         String
  version     Int
  value       Json
  isDevDefault Boolean @default(false)
  effectiveAt DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   AdminUser? @relation("SettingAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([key, version])
  @@index([key, effectiveAt])
}

model EmailJob {
  id             String        @id @default(cuid())
  dedupeKey      String        @unique
  eventKey       String
  template       String
  recipient      String
  payload        Json
  status         EmailJobStatus @default(QUEUED)
  attemptCount   Int           @default(0)
  availableAt    DateTime      @default(now())
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  errorDetail    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, availableAt])
  @@unique([eventKey, template, recipient])
}

model Job {
  id           String    @id @default(cuid())
  type         String
  dedupeKey    String?   @unique
  payload      Json?
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now())
  lockedAt     DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, availableAt])
}